{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlasrag.local/contracts/events/document.uploaded.v1.schema.json",
  "title": "AtlasRAG document.uploaded event",
  "description": "A PDF has been stored in object storage and registered for processing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "correlation_id",
    "document_id",
    "document_version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "document.uploaded"
    },
    "event_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "object_key",
        "content_hash",
        "mime_type",
        "file_size_bytes"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "object_key": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mime_type": {
          "const": "application/pdf"
        },
        "file_size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
